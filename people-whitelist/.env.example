PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql:///whitelist_app?host=/var/run/postgresql
SESSION_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: only set this if you need to pin a fixed callback URL.
# Otherwise the app uses the current browser host for /auth/callback.
GOOGLE_REDIRECT_URI=http://your-host.example.com/auth/callback
BOOTSTRAP_ADMIN_EMAIL=your-admin-email@example.com
